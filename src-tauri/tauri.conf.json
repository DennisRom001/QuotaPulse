{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaPulse",
  "version": "1.0.1",
  "identifier": "com.quotapulse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuotaPulse",
        "width": 360,
        "height": 390,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "minWidth": 360,
        "maxWidth": 360,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist",
      "providerShortName": null,
      "frameworks": []
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "tsp": false,
      "wix": null,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      },
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/sign-windows.ps1",
          "%1"
        ]
      }
    },
    "createUpdaterArtifacts": false,
    "resources": {
      "../start-litellm.bat": "start-litellm.bat"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/DennisRom001/QuotaPulse/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGNjVERUJFQzA1Q0FFNjUKUldSbHJsekF2dDVsdjdhZ204Y3U4YjFYRmdPS3dEMTJSR1JBY1l0alJGMDBNYmZQV2FJUE1xbjIK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "QuotaPulse"
}
