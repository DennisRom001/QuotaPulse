# QuotaPulse — environment variables (all optional).
#
# Names only: never put real values in this file or commit a filled-in copy.
# QuotaPulse reads these from the process environment and, on Windows, also
# from the user environment (HKCU\Environment), so `setx NAME value` is picked
# up without restarting the app. QuotaPulse does not load .env files itself.

# ── Claude ──────────────────────────────────────────────────────────────────
# Long-lived token from `claude setup-token` (otherwise ~/.claude/.credentials.json is used).
CLAUDE_CODE_OAUTH_TOKEN=
# Alternative Claude Code config dir(s), comma-separated.
CLAUDE_CONFIG_DIR=

# ── ChatGPT / Codex CLI ─────────────────────────────────────────────────────
# Alternative Codex home (default ~/.codex).
CODEX_HOME=

# ── Gemini ──────────────────────────────────────────────────────────────────
# Google AI Studio key (also read from ~/.gemini/.env). Validated only; Google
# exposes no usage figures for API keys.
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Code Assist project for the Gemini CLI quota lookup.
GOOGLE_CLOUD_PROJECT=

# ── LiteLLM Proxy (local only) ──────────────────────────────────────────────
# Proxy address; must be loopback (localhost / 127.0.0.1 / ::1). Default http://127.0.0.1:4000
LITELLM_PROXY_URL=
LITELLM_BASE_URL=
# Key QuotaPulse uses to query the proxy (falls back to LITELLM_MASTER_KEY).
LITELLM_API_KEY=
# Master key start-litellm.bat gives the proxy. If unset, a development-only
# default is used; set your own for anything beyond local testing.
LITELLM_MASTER_KEY=
# Set to 1 to stop QuotaPulse from auto-starting start-litellm.bat.
QP_DISABLE_LITELLM=

# ── App behaviour ───────────────────────────────────────────────────────────
# Set to 1 to start hidden in the tray (used by the autostart entry).
QP_AUTOSTART=

# ── Windows code signing (build time, src-tauri/scripts/sign-windows.ps1) ───
# Path to a .pfx code-signing certificate and its password…
QP_SIGN_PFX=
QP_SIGN_PFX_PASSWORD=
# …or the thumbprint of one installed in Cert:\CurrentUser\My.
QP_SIGN_THUMBPRINT=
